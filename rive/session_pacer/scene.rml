    <ComponentAsset artboardId="0:30" name="Breath"/>

    <!-- Glides the petals, petal rings and exhale mix to a new choice instead of snapping. -->
    <!-- One per input: an interpolator keeps its own running value, so binds reading different properties must not share one. -->
    <DataConverterInterpolator interpolationType="cubic" duration="0.4" name="Smooth Pace" id="0:520"/>
    <DataConverterInterpolator interpolationType="cubic" duration="0.4" name="Smooth Duration" id="0:521"/>

    <!-- Playback speed: the timelines are one breath at 6 a minute. -->
    <DataConverterFormula name="Pace Speed" id="0:530">
        <FormulaTokenInput/>
        <FormulaTokenOperation operationType="3"/>
        <FormulaTokenValue operationValue="6"/>
    </DataConverterFormula>
    <!-- How much of the long exhale mixes in: 1 at 4 breaths a minute, 0 at 12. -->
    <DataConverterFormula name="Exhale Mix" id="0:533">
        <FormulaTokenFunction functionType="0"/>
        <FormulaTokenValue operationValue="1"/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenFunction functionType="1"/>
        <FormulaTokenValue operationValue="0"/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenParenthesisOpen/>
        <FormulaTokenValue operationValue="12"/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenInput/>
        <FormulaTokenParenthesisClose/>
        <FormulaTokenOperation operationType="3"/>
        <FormulaTokenValue operationValue="8"/>
        <FormulaTokenParenthesisClose/>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterGroup name="Smooth Exhale Mix" id="0:534">
        <DataConverterGroupItem converterId="0:520"/>
        <DataConverterGroupItem converterId="0:533"/>
    </DataConverterGroup>

    <!-- Petal k sits at k * 2π / breathsPerMinute and shows while k < breathsPerMinute. -->
