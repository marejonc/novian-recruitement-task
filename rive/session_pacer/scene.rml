<Rive version="1" kind="fragment">
    <!--
        Session Bloom: the breathing guide on the session screen.

        The flower of the app icon: overlapping translucent circles around a
        solid core, in the same palette as the onboarding bloom (primary
        petals, primaryMuted halo), set by the app from its theme tokens.

        Everything the user picks reaches the file through the "Pacer" view model:

        - breathsPerMinute (4..12): one petal, and one tick outside the halo, per
          breath of a minute; at the
          default of 6 the flower is the app icon. Petals fade in and out and
          their spacing glides when the slider moves. The breath timelines
          play at breathsPerMinute / 6 (a 10 s breath at 6), and the host turns
          the whole flower once a minute, which is one petal spacing per breath
          at any pace. Slow paces mix in a longer
          exhale (2:3); fast ones breathe evenly (1:1).
        - durationMinutes (1, 3 or 5): rings of petals, like the onboarding bloom:
          inner only for 1 minute, plus a middle ring for 3, plus an outer for 5.

        Each breath the petals open out from the core on the inhale and gather
        back towards it on the exhale; the halo swells with them.

        Rive cannot bind a state's playback speed, so the breath lives in the
        nestable "Breath" artboard and the host plays its timelines through
        NestedSimpleAnimation, whose speed and mix are bindable. The nested
        artboard reads the host's view model.
    -->
    <Artboard defaultStateMachineId="0:300" viewModelId="0:100" viewModelInstanceId="0:101" styleId="0:3" width="400" height="400" name="Pacer" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:3"/>
        <!-- Turns the whole flower once a minute: one petal spacing per breath at any pace, and a full turn wraps seamlessly. -->
        <Node x="200" y="200" name="Turn" id="0:21">
        <NestedArtboard artboardId="0:30" x="-200" y="-200" name="Breath" id="0:20">
            <NestedSimpleAnimation animationId="0:200" isPlaying="true" name="Even">
                <DataBindContext sourcePathIds="0:100-0:110" propertyKey="199" converterId="0:530"/>
            </NestedSimpleAnimation>
            <!-- Mixed over Even: fully at 4 breaths a minute, gone at 12. -->
            <NestedSimpleAnimation animationId="0:201" isPlaying="true" name="Long Exhale">
                <DataBindContext sourcePathIds="0:100-0:110" propertyKey="199" converterId="0:530"/>
                <DataBindContext sourcePathIds="0:100-0:110" propertyKey="200" converterId="0:534"/>
            </NestedSimpleAnimation>
        </NestedArtboard>
        </Node>
        <LinearAnimation loopValue="loop" duration="3600" name="Turn" id="0:210">
            <KeyedObject objectId="0:21">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble frame="0" value="0" interpolationType="linear"/>
                    <KeyFrameDouble frame="3600" value="6.2831853"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <!-- Runs the data binds and the turn; the breath itself is in the nested timelines. -->
        <StateMachine name="Pacer" id="0:300">
            <StateMachineLayer name="Turn" id="0:310">
                <AnyState x="0" y="-150"/>
                <ExitState x="300" y="-150"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:311"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:210" id="0:311"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <Artboard isComponent="true" viewModelId="0:100" styleId="0:31" x="500" width="400" height="400" name="Breath" id="0:30">
        <LayoutComponentStyle name="Artboard Style" id="0:31"/>

        <!-- Cream centre of the logo, on top of the petals but softened so it does not outshine them. -->
        <Shape x="200" y="200" opacity="0.75" name="Core" id="0:70">
